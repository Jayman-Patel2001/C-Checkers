// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role: "ADMIN" | "EMPLOYEE" | "CO_ADMIN"
// TaskCategory: "WORK" | "PERSONAL"
// TaskStatus: "PENDING" | "ACTIVE" | "PAUSED" | "COMPLETED"
// TaskEvent: "CREATED" | "STARTED" | "PAUSED" | "RESUMED" | "COMPLETED"
// ReviewStatus: "APPROVED" | "REJECTED"

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("EMPLOYEE")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts           Shift[]
  taskEntries      TaskEntry[]
  reviews          Review[]           @relation("AdminReviews")
  scheduleEntries  EmployeeSchedule[] @relation("ScheduleEntries")
  payRates         EmployeePayRate[]  @relation("PayRates")
  paySummaries     WeeklyPaySummary[] @relation("PaySummaries")

  @@map("users")
}

model Shift {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime  @default(now())
  endTime   DateTime?
  createdAt DateTime  @default(now())

  taskEntries TaskEntry[]

  @@map("shifts")
}

model TaskDefinition {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String  @default("WORK")
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskEntries TaskEntry[]
  assignments TaskAssignment[]

  @@map("task_definitions")
}

// Maps which task definitions are assigned to which employees
// If no assignments exist for a task, it's visible to ALL employees
model TaskAssignment {
  id               String         @id @default(cuid())
  taskDefinitionId String
  taskDefinition   TaskDefinition @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)
  userId           String
  createdAt        DateTime       @default(now())

  @@unique([taskDefinitionId, userId])
  @@map("task_assignments")
}

model TaskEntry {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId             String
  shift               Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  taskDefinitionId    String?
  taskDefinition      TaskDefinition? @relation(fields: [taskDefinitionId], references: [id])
  name                String
  description         String?
  category            String    @default("WORK")
  isCustom            Boolean   @default(false)
  status              String    @default("PENDING")
  createdAt           DateTime  @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  activeIntervalStart DateTime?
  totalActiveTime     Int       @default(0)

  events TaskEventLog[]
  review Review?

  @@map("task_entries")
}

model TaskEventLog {
  id          String    @id @default(cuid())
  taskEntryId String
  taskEntry   TaskEntry @relation(fields: [taskEntryId], references: [id], onDelete: Cascade)
  event       String
  timestamp   DateTime  @default(now())
  note        String?

  @@map("task_event_logs")
}

model Review {
  id          String    @id @default(cuid())
  taskEntryId String    @unique
  taskEntry   TaskEntry @relation(fields: [taskEntryId], references: [id], onDelete: Cascade)
  adminId     String
  admin       User      @relation("AdminReviews", fields: [adminId], references: [id])
  status      String
  comment     String?
  reviewedAt  DateTime  @default(now())

  @@map("reviews")
}

// Default shop opening hours per day of week (0=Mon ... 6=Sun)
model ShopHours {
  id        String   @id @default(cuid())
  dayOfWeek Int
  openTime  String   // "06:00"
  closeTime String   // "23:00" | "00:00" means midnight
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
  @@map("shop_hours")
}

// One record per week (Mon-Sun)
model WeekSchedule {
  id                 String   @id @default(cuid())
  weekStartDate      DateTime // Monday midnight UTC
  weekEndDate        DateTime // Sunday midnight UTC
  visibleToEmployees Boolean  @default(true)
  createdAt          DateTime @default(now())

  employeeSchedules EmployeeSchedule[]
  paySummaries      WeeklyPaySummary[]

  @@map("week_schedules")
}

// One record per employee per day
model EmployeeSchedule {
  id             String       @id @default(cuid())
  weekScheduleId String
  weekSchedule   WeekSchedule @relation(fields: [weekScheduleId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ScheduleEntries", fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime     // date at midnight UTC
  scheduledStart String?      // "06:00"
  scheduledEnd   String?      // "23:00"
  isDayOff       Boolean      @default(false)
  clockIn        DateTime?
  clockOut       DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  wageOverrides WageOverride[]

  @@unique([weekScheduleId, userId, date])
  @@map("employee_schedules")
}

// Custom wage for a specific hour slot on a day
model WageOverride {
  id                 String           @id @default(cuid())
  employeeScheduleId String
  employeeSchedule   EmployeeSchedule @relation(fields: [employeeScheduleId], references: [id], onDelete: Cascade)
  hourSlot           Int              // 0-23 (hour of day)
  customWage         Float
  reason             String?
  createdAt          DateTime         @default(now())

  @@unique([employeeScheduleId, hourSlot])
  @@map("wage_overrides")
}

// Pay rate per employee (history tracked)
model EmployeePayRate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("PayRates", fields: [userId], references: [id], onDelete: Cascade)
  hourlyRate    Float
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  @@map("employee_pay_rates")
}

// Weekly pay summary per employee
model WeeklyPaySummary {
  id             String       @id @default(cuid())
  weekScheduleId String
  weekSchedule   WeekSchedule @relation(fields: [weekScheduleId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("PaySummaries", fields: [userId], references: [id], onDelete: Cascade)
  totalHours     Float        @default(0)
  totalAmount    Float        @default(0)
  isPaid         Boolean      @default(false)
  paidAt         DateTime?
  paidByAdminId  String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([weekScheduleId, userId])
  @@map("weekly_pay_summaries")
}
